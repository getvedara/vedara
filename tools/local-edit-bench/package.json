{
  "name": "local-edit-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Reproducible benchmark of how reliably local models (via Ollama) produce code edits in different edit formats.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "bench": "tsx src/cli.ts run",
    "report": "tsx src/cli.ts report",
    "list": "tsx src/cli.ts list",
    "verify-corpus": "tsx src/cli.ts verify-corpus",
    "dry-run": "tsx src/cli.ts run --dry-run",
    "gen-corpus": "tsx scripts/gen-long-tasks.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
