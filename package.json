{
  "name": "vedara",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "extensions:compile": "tsc -p extensions/vscode",
    "extensions:test": "vitest run extensions/vscode",
    "extensions:e2e": "npm run extensions:compile && node extensions/vscode/e2e/runTest.js",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "preview": "vite preview",
    "verify:airgap": "node scripts/verify-airgap.mjs",
    "verify:packaging": "node scripts/verify-packaging.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "benchmark": "node scripts/benchmark-suite.mjs",
    "benchmark:ollama": "node scripts/bench-ollama.mjs",
    "benchmark:rust": "node scripts/benchmark-suite.mjs --rust --skip-ollama",
    "bench:edit": "npm --prefix tools/local-edit-bench run bench --",
    "package": "node scripts/build-installers.mjs",
    "package:dry-run": "node scripts/build-installers.mjs --dry-run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "monaco-editor": "^0.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/test-electron": "^3.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^4.1.11"
  }
}
